{
  "openapi": "3.0.0",
  "info": {
    "title": "Library API",
    "version": "1.0.0",
    "description": "Demo API for testing the API Doc Sync Agent. Not real data.",
    "contact": {
      "email": "dev@library-test.io"
    },
    "x-tagGroups": [
      {
        "name": "Entities",
        "tags": [
          "Books",
          "Authors"
        ]
      }
    ]
  },
  "servers": [
    {
      "url": "https://api.library-test.io",
      "description": "Demo"
    }
  ],
  "security": [
    {
      "global": []
    }
  ],
  "tags": [
    {
      "name": "Books",
      "description": "Books operations"
    },
    {
      "name": "Authors",
      "description": "Authors operations"
    }
  ],
  "paths": {
    "/v1/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "List all books",
        "operationId": "showAllBooks",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Records per page (max 100)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort field",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "createdon",
                "updatedon"
              ],
              "default": "updatedon"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Sort direction",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooksList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorUnauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/v1/books/{book}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get a book by slug",
        "operationId": "showBook",
        "parameters": [
          {
            "name": "book",
            "in": "path",
            "description": "Slug of the book",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorUnauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Update a book",
        "operationId": "editBook",
        "parameters": [
          {
            "name": "book",
            "in": "path",
            "description": "Slug of the book",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Book object",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorUnauthorized"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Delete a book",
        "operationId": "deleteBook",
        "parameters": [
          {
            "name": "book",
            "in": "path",
            "description": "Slug of the book",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Operation"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorUnauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/v1/authors": {
      "get": {
        "tags": [
          "Authors"
        ],
        "summary": "List all authors",
        "operationId": "showAllAuthors",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "createdon",
                "updatedon"
              ],
              "default": "updatedon"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorsList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorUnauthorized"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Authors"
        ],
        "summary": "Create an author",
        "operationId": "storeAuthor",
        "requestBody": {
          "description": "Author object",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorRequest"
              },
              "examples": {
                "Example": {
                  "value": {
                    "name": "F. Scott Fitzgerald"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Author created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorUnauthorized"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "example": "2020-06-29T05:36:22.000000Z"
          },
          "updated_at": {
            "type": "string",
            "example": "2020-06-29T05:36:22.000000Z"
          }
        }
      },
      "BookRequest": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author_id": {
            "type": "integer"
          },
          "isbn": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "author_id",
          "isbn"
        ]
      },
      "BooksList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Pagination"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          }
        ]
      },
      "Author": {
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "slug": {
            "type": "string",
            "example": "fitzgerald"
          },
          "name": {
            "type": "string",
            "example": "F. Scott Fitzgerald"
          },
          "created_on": {
            "type": "string",
            "example": "2024-01-01T00:00:00.000000Z"
          },
          "updated_on": {
            "type": "string",
            "example": "2024-01-01T00:00:00.000000Z"
          }
        }
      },
      "AuthorRequest": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      },
      "AuthorsList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Pagination"
          },
          {
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Author"
                }
              }
            }
          }
        ]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer"
          },
          "first_page_url": {
            "type": "string"
          },
          "from": {
            "type": "integer"
          },
          "next_page_url": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "per_page": {
            "type": "integer"
          },
          "prev_page_url": {
            "type": "string"
          },
          "to": {
            "type": "integer"
          }
        }
      },
      "ErrorUnauthorized": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "global": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}